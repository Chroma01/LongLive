+    @staticmethod
+    def _toppra_topp(path, step=1.0 / 250, verbose=False):
+        path = np.asarray(path, dtype=float)
+        if path.ndim == 1:
+            path = path[None, :]
+        if len(path) < 2:
+            zeros = np.zeros_like(path)
+            return np.zeros(len(path)), path, zeros, zeros, 0.0
+        try:
+            keep = [0]
+            for index in range(1, len(path)):
+                if np.max(np.abs(path[index] - path[keep[-1]])) > 1e-6:
+                    keep.append(index)
+            waypoints = path[keep]
+            if len(waypoints) < 2:
+                zeros = np.zeros_like(path)
+                return np.zeros(len(path)), path, zeros, zeros, 0.0
+            grid = np.linspace(0.0, 1.0, len(waypoints))
+            spline = ta.SplineInterpolator(grid, waypoints)
+            dof = path.shape[1]
+            velocity_limits = np.tile([-TOPPRA_VEL_LIMIT, TOPPRA_VEL_LIMIT], (dof, 1))
+            acceleration_limits = np.tile([-TOPPRA_ACC_LIMIT, TOPPRA_ACC_LIMIT], (dof, 1))
+            instance = ta_algo.TOPPRA(
+                [
+                    ta_constraint.JointVelocityConstraint(velocity_limits),
+                    ta_constraint.JointAccelerationConstraint(acceleration_limits),
+                ],
+                spline,
+            )
+            trajectory = instance.compute_trajectory()
+            if trajectory is None:
+                raise RuntimeError("toppra returned no trajectory")
+            duration = float(trajectory.duration)
+            times = np.arange(0.0, duration, step)
+            if len(times) == 0 or times[-1] < duration - 1e-9:
+                times = np.append(times, duration)
+            return times, trajectory(times), trajectory(times, 1), trajectory(times, 2), duration
+        except Exception as error:
+            if verbose:
+                print(f"toppra failed; using interpolation fallback: {error}")
+            return MplibPlanner._interp_topp(path, step=step)
+
+    @staticmethod
+    def _interp_topp(path, step=1.0 / 250, vmax=1.0):
+        positions = [path[0]]
+        for start, end in zip(path[:-1], path[1:]):
+            delta = end - start
+            steps = max(int(np.ceil(max(float(np.max(np.abs(delta))) / vmax, step) / step)), 1)
+            positions.extend(start + delta * (index / steps) for index in range(1, steps + 1))
+        positions = np.asarray(positions)
+        velocity = np.zeros_like(positions)
+        velocity[1:] = np.diff(positions, axis=0) / step
+        times = np.arange(len(positions), dtype=float) * step
+        acceleration = np.zeros_like(positions)
+        return times, positions, velocity, acceleration, float(times[-1])
+
