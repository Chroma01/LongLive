@@ -0,0 +1,487 @@
+#include "cutlass/cutlass.h"
+
+#include "cute/tensor.hpp"
+#include "cutlass/epilogue/collective/collective_builder.hpp"
+#include "cutlass/gemm/collective/collective_builder.hpp"
+#include "cutlass/gemm/device/gemm_universal_adapter.h"
+#include "cutlass/gemm/group_array_problem_shape.hpp"
+#include "cutlass/gemm/kernel/gemm_universal.hpp"
+#include "cutlass/util/packed_stride.hpp"
+
+#include <ATen/ATen.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAGuard.h>
+#include <torch/all.h>
+
+#include <cstdint>
+#include <vector>
+
+#include "element_traits.hpp"
+#include "helper.h"
+
+namespace fouroversix
+{
+    using namespace cute;
+
+    using GroupedProblemShape = cutlass::gemm::GroupProblemShape<Shape<int, int, int>>;
+    using GroupedElementA = cutlass::nv_float4_t<cutlass::float_e2m1_t>;
+    using GroupedElementB = cutlass::nv_float4_t<cutlass::float_e2m1_t>;
+    using GroupedElementC = void;
+    using GroupedElementD = cutlass::bfloat16_t;
+    using GroupedAccumulator = float;
+    using GroupedLayoutA = cutlass::layout::RowMajor;
+    using GroupedLayoutB = cutlass::layout::ColumnMajor;
+    using GroupedLayoutC = cutlass::layout::RowMajor;
+    using GroupedLayoutD = cutlass::layout::RowMajor;
+    using GroupedTileShape = Shape<_128, _128, _128>;
+    using GroupedClusterShape = Shape<_1, _1, _1>;
+
+    constexpr int GroupedAlignmentA = 32;
+    constexpr int GroupedAlignmentB = 32;
+    constexpr int GroupedAlignmentC = 1;
+    constexpr int GroupedAlignmentD =
+        128 / cutlass::sizeof_bits<GroupedElementD>::value;
+
+    using GroupedCollectiveEpilogue =
+        typename cutlass::epilogue::collective::CollectiveBuilder<
+            cutlass::arch::Sm120,
+            cutlass::arch::OpClassBlockScaledTensorOp,
+            GroupedTileShape,
+            GroupedClusterShape,
+            cutlass::epilogue::collective::EpilogueTileAuto,
+            GroupedAccumulator,
+            GroupedAccumulator,
+            GroupedElementC,
+            GroupedLayoutC *,
+            GroupedAlignmentC,
+            GroupedElementD,
+            GroupedLayoutD *,
+            GroupedAlignmentD,
+            cutlass::epilogue::collective::EpilogueScheduleAuto>::CollectiveOp;
+
+    using GroupedCollectiveMainloop =
+        typename cutlass::gemm::collective::CollectiveBuilder<
+            cutlass::arch::Sm120,
+            cutlass::arch::OpClassBlockScaledTensorOp,
+            GroupedElementA,
+            GroupedLayoutA *,
+            GroupedAlignmentA,
+            GroupedElementB,
+            GroupedLayoutB *,
+            GroupedAlignmentB,
+            GroupedAccumulator,
+            GroupedTileShape,
+            GroupedClusterShape,
+            cutlass::gemm::collective::StageCountAutoCarveout<
+                static_cast<int>(sizeof(typename GroupedCollectiveEpilogue::SharedStorage))>,
+            cutlass::gemm::collective::KernelScheduleAuto>::CollectiveOp;
+
+    using GroupedGemmKernel = cutlass::gemm::kernel::GemmUniversal<
+        GroupedProblemShape,
+        GroupedCollectiveMainloop,
+        GroupedCollectiveEpilogue>;
+    using GroupedGemm =
+        cutlass::gemm::device::GemmUniversalAdapter<GroupedGemmKernel>;
+    using GroupedStrideA = typename GroupedGemmKernel::InternalStrideA;
+    using GroupedStrideB = typename GroupedGemmKernel::InternalStrideB;
+    using GroupedStrideC = typename GroupedGemmKernel::InternalStrideC;
+    using GroupedStrideD = typename GroupedGemmKernel::InternalStrideD;
+    using GroupedLayoutSFA =
+        typename GroupedCollectiveMainloop::InternalLayoutSFA;
+    using GroupedLayoutSFB =
+        typename GroupedCollectiveMainloop::InternalLayoutSFB;
+    using GroupedScaleElement =
+        typename GroupedCollectiveMainloop::ElementSF;
+    using GroupedScaleConfig =
+        typename GroupedCollectiveMainloop::Sm1xxBlkScaledConfig;
+
+    // Fixed-shape Q/K/V uses the same tuned mainloop as the regular production
+    // GEMM, but exposes the three projections as the L dimension.  This keeps
+    // the static scheduler and removes the 3-problem grouped metadata path.
+    using QkvTileShape = Shape<_128, _128, _128>;
+    using QkvClusterShape = Shape<_1, _1, _1>;
+    using QkvCollectiveEpilogue =
+        typename cutlass::epilogue::collective::CollectiveBuilder<
+            cutlass::arch::Sm120,
+            cutlass::arch::OpClassBlockScaledTensorOp,
+            QkvTileShape,
+            QkvClusterShape,
+            Shape<_32, _64>,
+            GroupedAccumulator,
+            GroupedAccumulator,
+            void,
+            cutlass::layout::RowMajor,
+            1,
+            GroupedElementD,
+            cutlass::layout::RowMajor,
+            GroupedAlignmentD,
+            cutlass::epilogue::collective::EpilogueScheduleAuto>::CollectiveOp;
+    using QkvCollectiveMainloop =
+        typename cutlass::gemm::collective::CollectiveBuilder<
+            cutlass::arch::Sm120,
+            cutlass::arch::OpClassBlockScaledTensorOp,
+            GroupedElementA,
+            cutlass::layout::RowMajor,
+            GroupedAlignmentA,
+            GroupedElementB,
+            cutlass::layout::ColumnMajor,
+            GroupedAlignmentB,
+            GroupedAccumulator,
+            QkvTileShape,
+            QkvClusterShape,
+            cutlass::gemm::collective::StageCount<5>,
+            cutlass::gemm::KernelTmaWarpSpecializedPingpong>::CollectiveOp;
+    using QkvGemmKernel = cutlass::gemm::kernel::GemmUniversal<
+        Shape<int, int, int, int>,
+        QkvCollectiveMainloop,
+        QkvCollectiveEpilogue,
+        void>;
+    using QkvGemm = cutlass::gemm::device::GemmUniversalAdapter<QkvGemmKernel>;
+    using QkvStrideA = typename QkvGemmKernel::StrideA;
+    using QkvStrideB = typename QkvGemmKernel::StrideB;
+    using QkvStrideC = typename QkvGemmKernel::StrideC;
+    using QkvStrideD = typename QkvGemmKernel::StrideD;
+    using QkvLayoutSFA = typename QkvCollectiveMainloop::LayoutSFA;
+    using QkvLayoutSFB = typename QkvCollectiveMainloop::LayoutSFB;
+    using QkvScaleConfig = typename QkvCollectiveMainloop::Sm1xxBlkScaledConfig;
+
+    template <typename T>
+    torch::Tensor device_buffer(int64_t count, torch::Device device)
+    {
+        return torch::empty(
+            {count * static_cast<int64_t>(sizeof(T))},
+            torch::dtype(torch::kUInt8).device(device));
+    }
+
+    __global__ void setup_grouped_gemm_metadata(
+        uint8_t const *A,
+        uint8_t const *B,
+        uint8_t const *A_sf,
+        uint8_t const *B_sf,
+        GroupedElementD *D,
+        GroupedAccumulator *alpha,
+        int groups,
+        int M,
+        int N,
+        int K,
+        int64_t B_group_bytes,
+        int64_t B_sf_group_bytes,
+        GroupedProblemShape::UnderlyingProblemShape *problems,
+        GroupedStrideA *strides_A,
+        GroupedStrideB *strides_B,
+        GroupedStrideC *strides_C,
+        GroupedStrideD *strides_D,
+        GroupedLayoutSFA *layouts_SFA,
+        GroupedLayoutSFB *layouts_SFB,
+        typename GroupedGemm::ElementA const **pointers_A,
+        typename GroupedGemm::ElementB const **pointers_B,
+        GroupedScaleElement const **pointers_SFA,
+        GroupedScaleElement const **pointers_SFB,
+        GroupedElementD **pointers_D,
+        GroupedAccumulator **pointers_alpha)
+    {
+        int const group = blockIdx.x * blockDim.x + threadIdx.x;
+        if (group >= groups)
+        {
+            return;
+        }
+        problems[group] = {M, N, K};
+        strides_A[group] = cutlass::make_cute_packed_stride(
+            GroupedStrideA{}, {M, K, 1});
+        strides_B[group] = cutlass::make_cute_packed_stride(
+            GroupedStrideB{}, {N, K, 1});
+        strides_C[group] = cutlass::make_cute_packed_stride(
+            GroupedStrideC{}, {M, N, 1});
+        strides_D[group] = cutlass::make_cute_packed_stride(
+            GroupedStrideD{}, {M, N, 1});
+        layouts_SFA[group] = GroupedScaleConfig::tile_atom_to_shape_SFA(
+            make_shape(M, N, K, 1));
+        layouts_SFB[group] = GroupedScaleConfig::tile_atom_to_shape_SFB(
+            make_shape(M, N, K, 1));
+        pointers_A[group] =
+            reinterpret_cast<typename GroupedGemm::ElementA const *>(A);
+        pointers_B[group] =
+            reinterpret_cast<typename GroupedGemm::ElementB const *>(
+                B + group * B_group_bytes);
+        pointers_SFA[group] =
+            reinterpret_cast<GroupedScaleElement const *>(A_sf);
+        pointers_SFB[group] =
+            reinterpret_cast<GroupedScaleElement const *>(
+                B_sf + group * B_sf_group_bytes);
+        pointers_D[group] = D + static_cast<int64_t>(group) * M * N;
+        pointers_alpha[group] = alpha + group;
+    }
+
+    torch::Tensor grouped_gemm_nvfp4nvfp4_accum_fp32_out_bf16_tnt_sm120(
+        torch::Tensor const &A,
+        torch::Tensor const &B,
+        torch::Tensor const &A_sf,
+        torch::Tensor const &B_sf,
+        torch::Tensor const &alpha,
+        int64_t logical_m)
+    {
+        at::cuda::CUDAGuard device_guard(A.device());
+        TORCH_CHECK(A.dim() == 2, "grouped NVFP4 A must be rank 2");
+        TORCH_CHECK(B.dim() == 3, "grouped NVFP4 B must be rank 3");
+        TORCH_CHECK(B.size(2) == A.size(1), "grouped NVFP4 K mismatch");
+        TORCH_CHECK(B_sf.size(0) == B.size(0), "grouped NVFP4 B_sf mismatch");
+        TORCH_CHECK(alpha.numel() == B.size(0), "grouped NVFP4 alpha mismatch");
+        torch::checkAllContiguous(
+            "grouped_gemm_nvfp4nvfp4_accum_fp32_out_bf16_tnt_sm120",
+            {{A, "A", 0}, {B, "B", 1}, {A_sf, "A_sf", 2},
+             {B_sf, "B_sf", 3}, {alpha, "alpha", 4}});
+        torch::checkAllSameGPU(
+            "grouped_gemm_nvfp4nvfp4_accum_fp32_out_bf16_tnt_sm120",
+            {{A, "A", 0}, {B, "B", 1}, {A_sf, "A_sf", 2},
+             {B_sf, "B_sf", 3}, {alpha, "alpha", 4}});
+
+        TORCH_CHECK(logical_m > 0, "grouped NVFP4 logical M must be positive");
+        TORCH_CHECK(logical_m <= A.size(0), "grouped NVFP4 logical M exceeds padded A");
+        int const groups = static_cast<int>(B.size(0));
+        int const M = static_cast<int>(logical_m);
+        int const N = static_cast<int>(B.size(1));
+        int const K = static_cast<int>(A.size(1) * 2);
+        auto D = torch::empty(
+            {groups, M, N},
+            torch::dtype(element_traits<GroupedElementD>::scalar_type)
+                .device(A.device()));
+        auto stream = at::cuda::getCurrentCUDAStream(A.get_device()).stream();
+
+        std::vector<GroupedProblemShape::UnderlyingProblemShape> problems(
+            groups, {M, N, K});
+        int64_t const B_group_bytes = B.numel() / groups;
+        int64_t const B_sf_group_bytes =
+            B_sf.numel() * B_sf.element_size() / groups;
+        auto problems_device = device_buffer<
+            GroupedProblemShape::UnderlyingProblemShape>(groups, A.device());
+        auto strides_A_device = device_buffer<GroupedStrideA>(groups, A.device());
+        auto strides_B_device = device_buffer<GroupedStrideB>(groups, A.device());
+        auto strides_C_device = device_buffer<GroupedStrideC>(groups, A.device());
+        auto strides_D_device = device_buffer<GroupedStrideD>(groups, A.device());
+        auto layouts_SFA_device = device_buffer<GroupedLayoutSFA>(groups, A.device());
+        auto layouts_SFB_device = device_buffer<GroupedLayoutSFB>(groups, A.device());
+        auto pointers_A_device = device_buffer<
+            typename GroupedGemm::ElementA const *>(groups, A.device());
+        auto pointers_B_device = device_buffer<
+            typename GroupedGemm::ElementB const *>(groups, A.device());
+        auto pointers_SFA_device = device_buffer<
+            GroupedScaleElement const *>(groups, A.device());
+        auto pointers_SFB_device = device_buffer<
+            GroupedScaleElement const *>(groups, A.device());
+        auto pointers_D_device = device_buffer<GroupedElementD *>(groups, A.device());
+        auto pointers_alpha_device = device_buffer<GroupedAccumulator *>(
+            groups, A.device());
+
+        int constexpr setup_threads = 128;
+        setup_grouped_gemm_metadata<<<
+            (groups + setup_threads - 1) / setup_threads,
+            setup_threads,
+            0,
+            stream>>>(
+                static_cast<uint8_t const *>(A.data_ptr()),
+                static_cast<uint8_t const *>(B.data_ptr()),
+                static_cast<uint8_t const *>(A_sf.data_ptr()),
+                static_cast<uint8_t const *>(B_sf.data_ptr()),
+                static_cast<GroupedElementD *>(D.data_ptr()),
+                static_cast<GroupedAccumulator *>(alpha.data_ptr()),
+                groups,
+                M,
+                N,
+                K,
+                B_group_bytes,
+                B_sf_group_bytes,
+                reinterpret_cast<GroupedProblemShape::UnderlyingProblemShape *>(
+                    problems_device.data_ptr()),
+                reinterpret_cast<GroupedStrideA *>(strides_A_device.data_ptr()),
+                reinterpret_cast<GroupedStrideB *>(strides_B_device.data_ptr()),
+                reinterpret_cast<GroupedStrideC *>(strides_C_device.data_ptr()),
+                reinterpret_cast<GroupedStrideD *>(strides_D_device.data_ptr()),
+                reinterpret_cast<GroupedLayoutSFA *>(layouts_SFA_device.data_ptr()),
+                reinterpret_cast<GroupedLayoutSFB *>(layouts_SFB_device.data_ptr()),
+                reinterpret_cast<typename GroupedGemm::ElementA const **>(
+                    pointers_A_device.data_ptr()),
+                reinterpret_cast<typename GroupedGemm::ElementB const **>(
+                    pointers_B_device.data_ptr()),
+                reinterpret_cast<GroupedScaleElement const **>(
+                    pointers_SFA_device.data_ptr()),
+                reinterpret_cast<GroupedScaleElement const **>(
+                    pointers_SFB_device.data_ptr()),
+                reinterpret_cast<GroupedElementD **>(
+                    pointers_D_device.data_ptr()),
+                reinterpret_cast<GroupedAccumulator **>(
+                    pointers_alpha_device.data_ptr()));
+        C10_CUDA_KERNEL_LAUNCH_CHECK();
+
+        cutlass::KernelHardwareInfo hardware_info;
+        hardware_info.device_id = A.get_device();
+        hardware_info.sm_count =
+            cutlass::KernelHardwareInfo::query_device_multiprocessor_count(
+                hardware_info.device_id);
+        typename GroupedGemm::Arguments arguments;
+        decltype(arguments.epilogue.thread) fusion_args;
+        fusion_args.alpha = 0;
+        fusion_args.alpha_ptr_array =
+            reinterpret_cast<GroupedAccumulator **>(
+                pointers_alpha_device.data_ptr());
+        fusion_args.dAlpha = {_0{}, _0{}, 1};
+        fusion_args.beta = 0;
+        fusion_args.beta_ptr_array = nullptr;
+        fusion_args.dBeta = {_0{}, _0{}, 0};
+
+        arguments = typename GroupedGemm::Arguments{
+            cutlass::gemm::GemmUniversalMode::kGrouped,
+            {groups,
+             reinterpret_cast<GroupedProblemShape::UnderlyingProblemShape *>(
+                 problems_device.data_ptr()),
+             problems.data()},
+            {reinterpret_cast<typename GroupedGemm::ElementA const **>(
+                 pointers_A_device.data_ptr()),
+             reinterpret_cast<GroupedStrideA *>(strides_A_device.data_ptr()),
+             reinterpret_cast<typename GroupedGemm::ElementB const **>(
+                 pointers_B_device.data_ptr()),
+             reinterpret_cast<GroupedStrideB *>(strides_B_device.data_ptr()),
+             reinterpret_cast<GroupedScaleElement const **>(
+                 pointers_SFA_device.data_ptr()),
+             reinterpret_cast<GroupedLayoutSFA *>(layouts_SFA_device.data_ptr()),
+             reinterpret_cast<GroupedScaleElement const **>(
+                 pointers_SFB_device.data_ptr()),
+             reinterpret_cast<GroupedLayoutSFB *>(layouts_SFB_device.data_ptr())},
+            {fusion_args,
+             nullptr,
+             reinterpret_cast<GroupedStrideC *>(strides_C_device.data_ptr()),
+             reinterpret_cast<GroupedElementD **>(pointers_D_device.data_ptr()),
+             reinterpret_cast<GroupedStrideD *>(strides_D_device.data_ptr())},
+            hardware_info};
+
+        GroupedGemm gemm;
+        size_t const workspace_size = GroupedGemm::get_workspace_size(arguments);
+        auto workspace = torch::empty(
+            {static_cast<int64_t>(workspace_size)},
+            torch::dtype(torch::kUInt8).device(A.device()));
+        CUTLASS_CHECK(gemm.can_implement(arguments));
+        CUTLASS_CHECK(gemm.initialize(arguments, workspace.data_ptr(), stream));
+        CUTLASS_CHECK(gemm.run(stream));
+        return D;
+    }
+
+    __global__ void replicate_qkv_sfa(
+        uint8_t const *source,
+        uint8_t *destination,
+        int64_t count)
+    {
+        int64_t const index =
+            static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+        if (index < count * 3)
+        {
+            destination[index] = source[index % count];
+        }
+    }
+
+    torch::Tensor qkv_gemm_nvfp4nvfp4_accum_fp32_out_bf16_tnt_sm120(
+        torch::Tensor const &A,
+        torch::Tensor const &B,
+        torch::Tensor const &A_sf,
+        torch::Tensor const &B_sf,
+        torch::Tensor const &alpha,
+        int64_t logical_m)
